# Environment variables to set in the Claude Code web UI (Environment settings).
# These are NOT committed — this file documents the names/shape only.

# --- Required ---------------------------------------------------------------
MEMORIES_URL=https://memories.example.com   # your hosted Memories backend
MEMORIES_API_KEY=replace-me                  # backend API key (X-API-Key)

# --- Required for cloning private repos in the sandbox ----------------------
SETUP_GH_TOKEN=ghp_xxx                        # GitHub PAT, read access to source repos

# --- Optional ---------------------------------------------------------------
BOOTSTRAP_REPO=divyekant/claude-cloud-setup   # this repo
MEMORIES_SRC_REPO=divyekant/memories          # source of hook scripts + MCP bridge
MEMORIES_SRC_REF=main
INSTALL_MCP=1                                  # 0 = hooks only, skip the Node MCP bridge
