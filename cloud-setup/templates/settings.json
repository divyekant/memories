{
  "hooks": {
    "SessionStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-recall.sh", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-query.sh", "timeout": 10 }] }],
    "Stop": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-extract.sh", "timeout": 30 }] }],
    "PreCompact": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-flush.sh", "timeout": 30 }] }],
    "PostCompact": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-rehydrate.sh", "timeout": 5 }] }],
    "PostToolUse": [
      { "matcher": "mcp__memories__", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-observe.sh", "timeout": 1 }] },
      { "matcher": "Write|Edit|Bash", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-tool-observe.sh", "timeout": 1 }] }
    ],
    "PreToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-guard.sh", "timeout": 1 }] }],
    "SubagentStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-subagent-recall.sh", "timeout": 5 }] }],
    "SubagentStop": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-subagent-capture.sh", "timeout": 30 }] }],
    "SessionEnd": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__HOOK_DIR__/memory-commit.sh", "timeout": 30 }] }]
  }
}
