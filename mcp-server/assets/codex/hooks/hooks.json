{
  "hooks": {
    "SessionStart": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-recall.sh",
        "timeout": 5
      }]
    }],
    "UserPromptSubmit": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-query.sh",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-extract.sh",
        "timeout": 30
      }]
    }],
    "PostToolUse": [{
      "matcher": "mcp__.*__memory_|exec",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-observe.sh",
        "timeout": 1
      }]
    }],
    "PreToolUse": [{
      "matcher": "Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-guard.sh",
        "timeout": 1
      }]
    }],
    "PreCompact": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-flush.sh",
        "timeout": 30
      }]
    }],
    "PostCompact": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-rehydrate.sh",
        "timeout": 5
      }]
    }],
    "SubagentStart": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-subagent-recall.sh",
        "timeout": 5
      }]
    }],
    "SubagentStop": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-subagent-capture.sh",
        "timeout": 30
      }]
    }],
    "SessionEnd": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${MEMORIES_HOOKS_DIR:-~/.codex/hooks/memory}/memory-commit.sh",
        "timeout": 3
      }]
    }]
  }
}
