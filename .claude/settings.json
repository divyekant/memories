{
  "extraKnownMarketplaces": {
    "dk-marketplace": {
      "source": {
        "source": "github",
        "repo": "divyekant/dk-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "memories@dk-marketplace": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-recall.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-query.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-extract.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-flush.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-rehydrate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__memory_",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-observe.sh",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-tool-observe.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-guard.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-subagent-recall.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-subagent-capture.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/mcp-server/assets/claude-code/hooks/repo-hook.sh\" memory-commit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
